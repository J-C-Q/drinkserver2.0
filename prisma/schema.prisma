// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Rarity {
  COMMON
  RARE
  LEGENDARY
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  authorized        Boolean   @default(false)
  image             String?
  password          String?
  role              UserRole  @default(USER)
  // Sessions that signed in before this time are rejected (password reset).
  passwordChangedAt DateTime?
  accounts          Account[]
  achievements      String[]
  orders            Order[]
  payments          Payment[] @relation("PaymentUser")
  confirmedPayments Payment[] @relation("PaymentConfirmedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  // SHA-256 of the token; the token itself is only in the emailed link.
  tokenHash String   @unique
  expires   DateTime

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  // SHA-256 of the token; the token itself is only in the emailed link.
  tokenHash String   @unique
  expires   DateTime

  @@index([email])
}

model Order {
  orderId    String      @id @default(cuid())
  userId     String
  username   String
  itemid     String
  itemname   String
  // Price at the time of the order, in euro cents.
  priceCents Int
  date       DateTime
  status     OrderStatus @default(PENDING)
  paymentId  String?

  // Orders are financial records: users and items that have orders
  // cannot be deleted.
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  item    Item     @relation(fields: [itemid], references: [itemid], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, status, date])
  @@index([userId, date])
  @@index([status])
  @@index([paymentId])
}

// A payment an admin confirmed, and the exact orders it settled.
model Payment {
  id            String   @id @default(cuid())
  userId        String
  // Amount the admin recorded as received, in euro cents.
  amountCents   Int
  // Sum of the settled orders, in euro cents.
  ordersCents   Int
  reference     String?
  createdAt     DateTime @default(now())
  confirmedById String

  user        User    @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  confirmedBy User    @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  orders      Order[]

  @@index([userId, createdAt])
}

// Fixed-window counters for rate limiting (login, register, reset).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

model Item {
  itemid       String  @id @default(cuid())
  itemname     String  @unique
  // Current price in euro cents.
  priceCents   Int
  quantity     Int
  energy       Float?
  carbohydrate Float?
  sugar        Float?
  caffeine     Float?
  image        String?
  description  String?
  bgcolor      String?
  color        String?
  orders       Order[]
}

model Achievement {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  rarity      Rarity  @default(COMMON)
  image       String?
}
