# Copy to .env (production values) or .env.development.local (local values).

# Postgres. DATABASE_URL may be pooled; DIRECT_URL must be a direct connection
# (used by Prisma migrations and pg_dump).
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
# Required when not running on Vercel (e.g. locally): AUTH_TRUST_HOST=true
AUTH_TRUST_HOST=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Email (Resend) and the public URL used in email links
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=
